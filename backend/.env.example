# Django Secret Key - Set a random secret string for production
SECRET_KEY=

# Debug Mode
DEBUG=False

# Allowed Hosts
ALLOWED_HOSTS=zcaleup.onrender.com,localhost,127.0.0.1

# PostgreSQL Database Connection URL
# Replace DB_USERNAME, DB_PASSWORD, and DB_NAME with your actual PostgreSQL credentials
DATABASE_URL=postgresql://DB_USERNAME:DB_PASSWORD@localhost:5432/DB_NAME

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=https://zcaleup.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Groq AI API Configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenAI API Configuration (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
