# Django Secret Key - Generate a secure random string for production
SECRET_KEY=

# Debug Mode - Set to False in production
DEBUG=True

# Allowed Hosts - Comma-separated list of hostnames allowed to serve the app
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Connection URL - PostgreSQL URL (e.g., postgres://user:password@hostname:5432/dbname)
# Leave empty for local SQLite development fallback
DATABASE_URL=

# CORS Allowed Origins - Comma-separated frontend URLs allowed to make requests
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenAI API Key - Provide your OpenAI API key for chatbot functionality
OPENAI_API_KEY=

# OpenAI Model - Model to use for the chatbot (e.g., gpt-4o-mini, gpt-4o)
OPENAI_MODEL=gpt-4o-mini
